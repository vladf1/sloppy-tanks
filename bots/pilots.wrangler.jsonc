{
  // The pilots (bots/pilots-worker.ts). No public address: the bots Worker's control page
  // and API reach it over their PILOTS service binding. Deploy it first, and again from
  // the commit the game servers run (`bun run pilots:deploy`).
  "name": "sloppy-tanks-pilots",
  "main": "pilots-worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "durable_objects": { "bindings": [{ "name": "SQUAD", "class_name": "PilotSwarm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PilotSwarm"] }],
  "observability": { "enabled": true },
  "vars": {
    // The same directory and environment as bots/wrangler.jsonc (a test keeps them equal).
    "DIRECTORY_URL": "https://sloppy-tanks-directory.fridman.me",
    "SERVER_ENVIRONMENT": "production",
  },
}
