{
  "name": "sloppy-tanks-server-dev",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-23",
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "MATCH", "class_name": "PlayerRoom" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["PlayerRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["RoomDirectory"] },
  ],
  "ratelimits": [
    {
      "name": "CONNECTION_RATE",
      "namespace_id": "9262301",
      "simple": { "limit": 60, "period": 60 },
    },
    { "name": "ENTRY_RATE", "namespace_id": "9262302", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "DIRECTORY_RATE",
      "namespace_id": "9262303",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  "vars": {
    "EXPERIMENT_ENABLED": "false",
    "MULTIPLAYER_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://sloppy-tanks-dev.fridman.me,https://sloppy-tanks-dev.pages.dev,https://fridman.me,https://sloppy-tanks.fridman.me,https://sloppy-tanks.pages.dev,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:4179,http://127.0.0.1:4180,http://localhost:5173,http://localhost:5174",
  },
}
