{
  "name": "sloppy-tanks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:cloudflare": "tsc --noEmit && DEPLOY_BASE=/ vite build --outDir dist-cloudflare",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "check:browser": "node scripts/browser-checks.mjs",
    "generate:textures": "node --import tsx scripts/generate-textures.ts && node scripts/optimize-textures.mjs && npm run generate:pickup-atlas",
    "optimize:textures": "node scripts/optimize-textures.mjs",
    "generate:previews": "node scripts/generate-previews.mjs",
    "benchmark:loading": "node scripts/loading-benchmark.mjs",
    "generate:ammo": "node --import tsx scripts/generate-ammo-icons.ts && npm run generate:pickup-atlas",
    "generate:pickup-atlas": "node --import tsx scripts/generate-pickup-atlas.ts",
    "generate:audio": "node --import tsx scripts/generate-audio.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project server/tsconfig.json --noEmit && tsc --project bots/tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run build && npm run server:build && npm test",
    "postinstall": "npm ci --prefix tools/lint",
    "build:dev": "tsc --noEmit && DEPLOY_BASE=/ vite build --config vite.dev.config.ts",
    "deploy:dev": "npm run check && npm run build:dev && node scripts/deploy-dev.mjs",
    "server:build": "node server/build.mjs",
    "server:dev": "npm run server:build && node --enable-source-maps server/dist/server.mjs",
    "vps:deploy": "npm run check && node scripts/deploy-vps.mjs",
    "vps:provision": "node scripts/deploy-vps.mjs --provision",
    "vps:logs": "node scripts/vps.mjs logs",
    "vps:stats": "node scripts/vps.mjs stats",
    "vps:status": "node scripts/vps.mjs status",
    "check:multiplayer-loading": "node scripts/multiplayer-loading-check.mjs",
    "check:multiplayer": "node scripts/multiplayer-check.mjs",
    "server:check:players": "node --import tsx scripts/multiplayer-player-check.mjs",
    "bots": "node scripts/bots.mjs",
    "bots:deploy": "wrangler deploy --config bots/wrangler.jsonc"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "howler": "2.2.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@tweakpane/core": "2.0.5",
    "@types/howler": "2.2.13",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.136.3",
    "ws": "8.21.3"
  }
}
