{
  "name": "sloppy-tanks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run wasm && pnpm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "cargo run --locked --release -p sloppy-core --example validate",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:labs": "node scripts/build-wasm.mjs --labs",
    "check:browser": "node scripts/browser-checks.mjs",
    "generate:textures": "node --import tsx scripts/generate-textures.ts && node scripts/optimize-textures.mjs && pnpm run generate:pickup-atlas",
    "optimize:textures": "node scripts/optimize-textures.mjs",
    "generate:previews": "pnpm run wasm:labs && node scripts/generate-previews.mjs",
    "benchmark:loading": "node scripts/loading-benchmark.mjs",
    "generate:ammo": "node --import tsx scripts/generate-ammo-icons.ts && pnpm run generate:pickup-atlas",
    "generate:pickup-atlas": "node --import tsx scripts/generate-pickup-atlas.ts",
    "generate:audio": "node --import tsx scripts/generate-audio.ts",
    "generate:favicon": "node --import tsx scripts/generate-favicon.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project bots/tsconfig.json --noEmit",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --locked --workspace --all-targets -- -D warnings && cargo clippy --locked --target wasm32-unknown-unknown -p sloppy-render -p sloppy-web -- -D warnings && cargo clippy --locked --target wasm32-unknown-unknown -p sloppy-web --features labs -- -D warnings",
    "test:rust": "cargo test --locked --workspace",
    "check": "pnpm run check:site && pnpm run check:rust-lint && pnpm run check:server && pnpm run test:rust",
    "check:site": "pnpm run format:check && pnpm run build && pnpm run lint",
    "check:rust-lint": "pnpm run rust:fmt && pnpm run rust:clippy",
    "check:server": "pnpm run server:build && pnpm test",
    "postinstall": "pnpm --dir tools/lint install --frozen-lockfile",
    "build:dev": "pnpm run wasm && pnpm run wasm:labs && pnpm run typecheck && DEPLOY_BASE=/ vite build --config vite.dev.config.ts",
    "deploy:dev": "pnpm run check && pnpm run build:dev && node scripts/deploy-dev.mjs",
    "server:build": "node scripts/build-server.mjs",
    "server:dev": "node scripts/build-server.mjs && ./target/server/sloppy-server",
    "server:build-docker-image": "node scripts/build-server-image.mjs",
    "server:deploy-check": "cargo fmt -p sloppy-core -p sloppy-server --check && cargo clippy --locked -p sloppy-core -p sloppy-server --all-targets -- -D warnings && cargo test --locked -p sloppy-core -p sloppy-server",
    "server:deploy": "pnpm run server:deploy-check && node scripts/deploy-vps.mjs",
    "server:update": "node scripts/server-update.mjs pull",
    "server:rollback": "node scripts/server-update.mjs rollback",
    "server:auto-update": "node scripts/server-update.mjs auto",
    "server:provision": "node scripts/deploy-vps.mjs --provision",
    "server:provision:dev": "node scripts/deploy-vps.mjs --dev --provision",
    "server:logs": "node scripts/vps.mjs logs",
    "server:stats": "node scripts/vps.mjs stats",
    "server:status": "node scripts/vps.mjs status",
    "server:check-if-redeployment-required": "node scripts/check-server-redeployment.mjs",
    "check:multiplayer-loading": "node scripts/multiplayer-loading-check.mjs",
    "check:multiplayer": "node scripts/multiplayer-check.mjs",
    "server:check:players": "node --import tsx scripts/multiplayer-player-check.mjs",
    "bots": "node scripts/bots.mjs",
    "bots:deploy": "wrangler deploy --config bots/wrangler.jsonc"
  },
  "dependencies": {
    "howler": "2.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@tweakpane/core": "2.0.5",
    "@types/howler": "2.2.13",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "tweakpane": "4.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.136.3",
    "ws": "8.21.3"
  }
}
