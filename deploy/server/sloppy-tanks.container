# The template of a version's server unit, installed to /etc/sloppy-tanks/ by bootstrap.sh.
# sloppy-tanks-update writes one Quadlet unit from it per content version the machine runs,
# /etc/containers/systemd/sloppy-tanks-<content version>.container, filling in @CONTENT@,
# @PORT@ and @IMAGE@; systemd generates sloppy-tanks-<content version>.service from it,
# which runs the server under Podman with no daemon beside it.
[Unit]
Description=Sloppy Tanks multiplayer server, content @CONTENT@
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=sloppy-tanks-@CONTENT@
# The image ID the updater pinned, always local, so a crash or reboot never needs the
# registry.
Image=@IMAGE@
Pull=never
# Host networking keeps the listener on loopback behind Caddy, which reaches it there and
# serves it under /v/@CONTENT@/, and leaves no ports to publish past the firewall.
Network=host
Environment=HOST=127.0.0.1 PORT=@PORT@ PUBLIC_PATH=/v/@CONTENT@
# The machine's settings: SERVER_ENVIRONMENT (production, dev or app-store) and
# DIRECTORY_URL, which the server pushes its rooms to. The provider's user data writes it
# (deploy/server/cloud-init/).
EnvironmentFile=/etc/sloppy-tanks/server.env
# A read-only root without Podman's extra tmpfs mounts, no capabilities, and a memory cap
# without swap. A machine runs up to five versions (an idle server holds 5-20 MB, a busy
# one tens), so each is capped well under the machine's 1 GB.
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=ALL
NoNewPrivileges=true
Memory=300m
PodmanArgs=--memory-swap 300m
PidsLimit=256
Ulimit=nofile=65536:65536
# Output goes straight to the unit's journal (bun run server:logs).
LogDriver=passthrough
# SIGTERM resets rooms and waits up to a second for clients to finish closing.
StopTimeout=10

[Service]
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
