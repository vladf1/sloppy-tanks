#!/usr/bin/env bash
# Runs the machine's game servers: one container per content version its environment keeps,
# each on its own loopback port behind Caddy's /v/<content version>/, and keeps their
# pinned-image state. bootstrap.sh installs it as /usr/local/bin/sloppy-tanks-update; the
# server:* scripts call it over SSH and sloppy-tanks-update.timer runs `auto`.
#
#   sloppy-tanks-update pull [REF]    with no REF, follow the deployment file now: start, switch and stop
#                                     versions without waiting for players; with REF, run
#                                     that image as its content version's server and hold
#   sloppy-tanks-update local IMAGE   the same for an image already loaded here (SSH deploy)
#   sloppy-tanks-update rollback      switch the root version back to its previous image
#   sloppy-tanks-update resume        let auto-update follow the deployment file again
#   sloppy-tanks-update auto          the timer's check (see auto below)
#   sloppy-tanks-update caddyfile     write Caddy's config for the versions running now
#   sloppy-tanks-update status | stats
#
# The machine follows its environment's deployment file (production, dev or app-store,
# from server.env), the tag deployment-<environment> beside the server images, which
# scripts/promote-server.mjs writes (scripts/deployment.mjs): the newest content versions
# published to the environment, newest first, each with the digest of its server image.
# Every version listed runs: a player's app or page joins only a server of its own content
# version, so an App Store version keeps its server after newer ones reach TestFlight, and
# a deploy no longer restarts the rooms of the version before it.
#
# A version leaves the list once newer ones push it out; its server stops once its rooms
# are empty, or after a room's lifetime. A new image of a listed version (a server-only
# change) replaces its server the same way. Dev switches and stops at once, without
# looking at who plays. The root of the site serves the newest version (the scripts check
# /health there). Anything but following the file leaves a hold that auto-update respects
# until `resume` or a `pull` of the file, and on dev until the next publish.
set -euo pipefail

# Tests run the script under a scratch directory with fake podman, systemctl and curl.
ROOT=${SLOPPY_TANKS_ROOT:-}
REGISTRY=ghcr.io/vladf1/sloppy-tanks-server
# At most this many listed versions run (promote-server.mjs keeps as many).
MAX_VERSIONS=5
# Each version's server listens on a loopback port from BASE_PORT, which Caddy forwards to.
# Servers of versions on their way out keep theirs until they stop, hence the spare ports.
BASE_PORT=8787
PORTS=$((2 * MAX_VERSIONS))
STATE=$ROOT/var/lib/sloppy-tanks
CONFIG=$ROOT/etc/sloppy-tanks
QUADLET=$ROOT/etc/containers/systemd
# The server's unit, with @CONTENT@, @PORT@ and @IMAGE@ for each version.
TEMPLATE=$CONFIG/sloppy-tanks.container
CADDYFILE=$CONFIG/caddy/Caddyfile
# Local tags that keep the images the servers run, could roll back to or will start from
# being pruned.
PINNED=sloppy-tanks-pinned
LABELS=me.fridman.sloppy-tanks
HEALTH_TIMEOUT_SECONDS=${SLOPPY_TANKS_HEALTH_TIMEOUT:-60}
# A server waits for its rooms to empty before it is replaced or stopped, but not forever:
# at most a room's four-hour lifetime.
MAX_WAIT_SECONDS=14400
# The deployment file is an OCI artifact: an image manifest whose one layer is the JSON.
MANIFEST_TYPE=application/vnd.oci.image.manifest.v1+json

usage() {
  echo "usage: sloppy-tanks-update pull [REF]|local IMAGE|rollback|resume|auto|caddyfile|status|stats" >&2
  exit 2
}
command=${1:-}
# The versions the deployment file lists: `<content> <image ID>` lines, newest first.
wanted_file=$STATE/wanted
# The version the site's root serves.
root_file=$STATE/root
hold_file=$STATE/hold
# The deployment file's manifest digest at its latest read.
followed_file=$STATE/followed
# Present while checks cannot read the deployment file from the registry.
failing_file=$STATE/check-failing
mkdir -p "$STATE/versions"

# The machine's environment (server.env, which the provider's user data writes)
# names the deployment file auto-update follows.
environment=$(sed -n 's/^SERVER_ENVIRONMENT=//p' "$CONFIG/server.env" 2>/dev/null || true)
follow=$REGISTRY:deployment-${environment:-production}

# One change at a time. The timer skips a check while another runs.
mkdir -p "$ROOT/run/lock"
exec 9>"$ROOT/run/lock/sloppy-tanks-update.lock"
if [[ $command == auto ]]; then
  flock --nonblock 9 || exit 0
else
  flock 9
fi

# Each version's state lives in versions/<content>/: image and previous (pinned image IDs),
# port, pending (`<image> <since>`), failed and retiring (`<since>`).
version_dir() { echo "$STATE/versions/$1"; }
read_file() { [[ -f $1 ]] && cat "$1" || true; }
write_file() { printf '%s\n' "$2" >"$1.new" && mv -f "$1.new" "$1"; }
label() { podman image inspect --format "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null || true; }
# Podman prints IDs without their sha256: prefix but accepts it, and lists them with it.
image_id() {
  local id
  id=$(podman image inspect --format '{{.Id}}' "$1") && echo "sha256:${id#sha256:}"
}
describe() {
  echo "${1:0:19} (v$(label "$1" $LABELS.release), server build $(label "$1" $LABELS.server-build), content $(label "$1" $LABELS.content-version), commit $(label "$1" org.opencontainers.image.revision))"
}
unit() { echo "sloppy-tanks-$1"; }
port_of() { read_file "$(version_dir "$1")/port"; }
# The versions with a server here, from their state directories.
running() {
  local dir
  for dir in "$STATE"/versions/*/; do
    if [[ -f ${dir}image ]]; then basename "$dir"; fi
  done
}
wanted() { [[ -f $wanted_file ]] && cut -d' ' -f1 "$wanted_file" || true; }
is_wanted() { wanted | grep -qxF "$1"; }
hold() { echo "$1 at $(describe "$2") on $(date -u +%FT%TZ)" >"$hold_file"; }

# A content version names a unit, a path and a directory, so only hex passes.
check_content() {
  [[ $1 =~ ^[0-9a-f]{8,64}$ ]] || {
    echo "Not a content version: '$1'" >&2
    return 1
  }
}

# The lowest port no server here holds.
free_port() {
  local port used
  used=$(for content in $(running); do port_of "$content"; done)
  for ((port = BASE_PORT; port < BASE_PORT + PORTS; port++)); do
    grep -qxF "$port" <<<"$used" || {
      echo "$port"
      return 0
    }
  done
  echo "No free port for another server (at most $PORTS)" >&2
  return 1
}

# Writes the version's Quadlet unit for IMAGE from the template, and its settings: the
# machine's server.env, with the directory's /v/<content version>/servers as where it
# announces, so the directory lists it at that path on this machine. Server builds from
# before machines ran several versions know nothing of paths, but take their
# DIRECTORY_URL as given. systemd sees the unit only after regenerating its units.
write_unit() {
  local content=$1 image=$2 port directory settings
  port=$(port_of "$content")
  settings=$(version_dir "$content")/server.env
  directory=$(sed -n 's/^DIRECTORY_URL=//p' "$CONFIG/server.env" 2>/dev/null || true)
  {
    grep -v '^DIRECTORY_URL=' "$CONFIG/server.env" 2>/dev/null || true
    if [[ -n $directory ]]; then echo "DIRECTORY_URL=${directory%/}/v/$content"; fi
  } >"$settings"
  sed -e "s/@CONTENT@/$content/g" -e "s/@PORT@/$port/g" -e "s/@IMAGE@/$image/g" \
    -e "s|@SETTINGS@|$settings|g" "$TEMPLATE" >"$QUADLET/$(unit "$content").container.new"
  mv -f "$QUADLET/$(unit "$content").container.new" "$QUADLET/$(unit "$content").container"
  systemctl daemon-reload
}

# /health reports the stamps of the process that answers, so a match means the new
# container, not the one it replaced, is serving.
healthy() {
  local port=$1 image=$2 build content body waited=0
  build=$(label "$image" $LABELS.server-build)
  content=$(label "$image" $LABELS.content-version)
  for (( ; ; waited += 2)); do
    body=$(curl -fsS --max-time 2 "http://127.0.0.1:$port/health" 2>/dev/null | tr -d ' \n' || true)
    if [[ $body == *"\"contentVersion\":\"$content\""* && $body == *"\"serverBuild\":\"$build\""* ]]; then
      return 0
    fi
    if ((waited >= HEALTH_TIMEOUT_SECONDS)); then return 1; fi
    sleep 2
  done
}

# The seats taken on a version's server; one that does not answer has nobody to protect.
# The top-level count: each room in /stats has a "players" field too.
players() {
  local players
  players=$(curl -fsS --max-time 5 "http://127.0.0.1:$(port_of "$1")/stats" 2>/dev/null |
    python3 -c 'import json, sys; print(int(json.load(sys.stdin)["players"]))' 2>/dev/null || true)
  echo "${players:-0}"
}

# Starts a server for a version this machine does not run yet.
start_version() {
  local content=$1 image=$2 dir port
  dir=$(version_dir "$content")
  port=$(free_port) || return 1
  mkdir -p "$dir"
  write_file "$dir/port" "$port"
  write_file "$dir/image" "$image"
  podman tag "$image" "$PINNED:$content"
  write_unit "$content" "$image"
  echo "Starting $(unit "$content") on port $(port_of "$content"): $(describe "$image")"
  systemctl restart "$(unit "$content")"
  if healthy "$(port_of "$content")" "$image"; then
    echo "$(unit "$content") runs $(describe "$image")"
    rm -f "$dir/failed"
    return 0
  fi
  echo "$(unit "$content") did not report $(describe "$image") within ${HEALTH_TIMEOUT_SECONDS}s" >&2
  stop_version "$content"
  mkdir -p "$dir"
  write_file "$dir/failed" "$image"
  return 1
}

# Switches a running version's server to another image of it, restoring the one it ran
# when the new one fails its health check.
switch_version() {
  local content=$1 new=$2 dir current
  dir=$(version_dir "$content")
  current=$(read_file "$dir/image")
  if [[ $new == "$current" ]] && systemctl is-active --quiet "$(unit "$content")"; then
    echo "$(unit "$content") already runs $(describe "$new")"
    return 0
  fi
  write_file "$dir/image" "$new"
  podman tag "$new" "$PINNED:$content"
  write_unit "$content" "$new"
  echo "Restarting $(unit "$content") on $(describe "$new")"
  systemctl restart "$(unit "$content")"
  if healthy "$(port_of "$content")" "$new"; then
    echo "$(unit "$content") runs $(describe "$new")"
    # Only now does the image it replaced become the one to roll back to.
    if [[ -n $current && $current != "$new" ]]; then
      write_file "$dir/previous" "$current"
      podman tag "$current" "$PINNED:$content-previous"
    fi
    rm -f "$dir/failed" "$dir/pending"
    return 0
  fi
  echo "$(unit "$content") did not report $(describe "$new") within ${HEALTH_TIMEOUT_SECONDS}s" >&2
  write_file "$dir/failed" "$new"
  if [[ -n $current && $current != "$new" ]]; then
    write_file "$dir/image" "$current"
    podman tag "$current" "$PINNED:$content"
    write_unit "$content" "$current"
    systemctl restart "$(unit "$content")"
    if healthy "$(port_of "$content")" "$current"; then
      echo "Rolled back to $(describe "$current")" >&2
    else
      echo "The previous image is not healthy either; see journalctl -u $(unit "$content")" >&2
    fi
  fi
  return 1
}

# Runs IMAGE as its content version's server now (an SSH deploy or a pulled tag),
# switching the one running or starting one, and serves it at the root. A version started
# this way that the tag does not list is an override: the next override replaces it, so
# repeated deploys of unlisted versions do not pile up.
run_now() {
  local image=$1 content other
  content=$(label "$image" $LABELS.content-version)
  check_content "$content"
  if [[ -f $(version_dir "$content")/image ]]; then
    switch_version "$content" "$image"
  else
    start_version "$content" "$image"
    touch "$(version_dir "$content")/override"
  fi
  write_file "$root_file" "$content"
  for other in $(running); do
    if [[ $other != "$content" && -f $(version_dir "$other")/override ]] && ! is_wanted "$other"; then
      stop_version "$other"
    fi
  done
}

stop_version() {
  local content=$1
  echo "Stopping $(unit "$content")"
  systemctl stop "$(unit "$content")" || true
  rm -f "$QUADLET/$(unit "$content").container"
  systemctl daemon-reload
  podman image rm "$PINNED:$content" "$PINNED:$content-previous" "$PINNED:$content-listed" \
    >/dev/null 2>&1 || true
  rm -rf "$(version_dir "$content")"
}

# Caddy's config: each running version under /v/<content version>/ (with the prefix
# stripped, so its server sees the paths it serves at a root), and the root version at
# the root. The nip.io name of the machine's address is in site (bootstrap.sh). Caddy
# reloads only when the config changed.
write_caddyfile() {
  local site root content new
  site=$(cat "$CONFIG/site")
  root=$(read_file "$root_file")
  if [[ -z $root || ! -f $(version_dir "$root")/image ]]; then
    root=""
    for content in $(wanted) $(running); do
      if [[ -f $(version_dir "$content")/image ]]; then
        root=$content
        break
      fi
    done
  fi
  # X-Client-Port (with X-Forwarded-For) names the player's end of Caddy's socket to the
  # server, which reads its TCP round trip and retransmissions from it. A reload unloads the
  # old config, whose WebSockets Caddy would close at once: the delay keeps every match
  # going, on any version, for up to a room's lifetime.
  proxy() {
    printf '\t\treverse_proxy 127.0.0.1:%s {\n\t\t\theader_up X-Client-Port {remote_port}\n\t\t\tstream_close_delay %ss\n\t\t}\n' "$1" "$MAX_WAIT_SECONDS"
  }
  new=$(
    echo "# Written by sloppy-tanks-update for the servers running now."
    echo "$site {"
    for content in $(running | sort); do
      printf '\thandle_path /v/%s* {\n' "$content"
      proxy "$(port_of "$content")"
      printf '\t}\n'
    done
    printf '\thandle {\n'
    if [[ -n $root ]]; then
      proxy "$(port_of "$root")"
    else
      printf '\t\trespond "No game server runs here yet" 503\n'
    fi
    printf '\t}\n}\n'
  )
  if [[ $new == "$(read_file "$CADDYFILE")" ]]; then return 0; fi
  mkdir -p "$(dirname "$CADDYFILE")"
  local applied
  applied=$(read_file "$CADDYFILE")
  printf '%s\n' "$new" >"$CADDYFILE.new"
  mv -f "$CADDYFILE.new" "$CADDYFILE"
  if systemctl is-active --quiet caddy && ! systemctl reload caddy; then
    # Put back what Caddy still runs, so the next check finds a change and tries again.
    printf '%s\n' "$applied" >"$CADDYFILE"
    echo "Caddy did not reload its config; trying again at the next check" >&2
    return 1
  fi
  echo "Caddy routes /v/ to $(running | wc -l | tr -d ' ') versions, the root to ${root:-none}"
}

# Untags the server images no version runs, could roll back to or is listed to start,
# then prunes what is left untagged (Caddy's image stays tagged). Podman lists every name
# of a matching image, so only the registry's tags are considered.
remove_old_images() {
  local keep ref id content
  keep=$(
    for content in $(running); do
      read_file "$(version_dir "$content")/image"
      read_file "$(version_dir "$content")/previous"
    done
    [[ -f $wanted_file ]] && cut -d' ' -f2 "$wanted_file"
  )
  podman image ls --no-trunc --format '{{.Repository}}:{{.Tag}} {{.ID}}' "$REGISTRY" |
    while read -r ref id; do
      if [[ $ref != "$REGISTRY":* || $ref == *:\<none\> ]]; then continue; fi
      if ! grep -qxF "$id" <<<"$keep"; then podman image rm "$ref" >/dev/null || true; fi
    done
  podman image prune --force >/dev/null
}

HOST=${REGISTRY%%/*}
NAME=${REGISTRY#*/}
# A pull token for the repository from GHCR, anonymous as the images are public.
registry_token() {
  local token
  token=$(curl -fsS --max-time 5 "https://$HOST/token?scope=repository:$NAME:pull" 2>/dev/null |
    sed -n 's/.*"token":"\([^"]*\)".*/\1/p') || return 1
  [[ -n $token ]] && echo "$token"
}

# The deployment file's manifest digest in the registry: one manifest HEAD, so a check
# every few seconds reads the file only after the tag has moved.
remote_digest() {
  local token
  token=$(registry_token) || return 1
  curl -fsS --max-time 5 --head --header "Authorization: Bearer $token" \
    --header "Accept: $MANIFEST_TYPE" "https://$HOST/v2/$NAME/manifests/${follow##*:}" 2>/dev/null |
    tr -d '\r' | grep -i '^docker-content-digest:' | sed 's/^[^:]*: *//' | grep .
}

# The versions a deployment file lists (the followed one, or the tag TAG names) as
# `<content> <digest>` lines, newest first: its manifest, then its one layer, which GHCR
# serves through a redirect to storage (curl sends the token to the registry alone). The
# layer must hash to its digest.
read_deployment() {
  local tag=${1:-${follow##*:}} token manifest layer
  token=$(registry_token) || return 1
  manifest=$(curl -fsS --max-time 10 --header "Authorization: Bearer $token" \
    --header "Accept: $MANIFEST_TYPE" "https://$HOST/v2/$NAME/manifests/$tag") || return 1
  layer=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["layers"][0]["digest"])' \
    <<<"$manifest") || return 1
  [[ $layer =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  curl -fsSL --max-time 10 --header "Authorization: Bearer $token" \
    "https://$HOST/v2/$NAME/blobs/$layer" |
    python3 -c '
import hashlib, json, sys
data = sys.stdin.buffer.read()
if "sha256:" + hashlib.sha256(data).hexdigest() != sys.argv[1]:
    sys.exit("The deployment file does not match its digest")
for version in json.loads(data)["versions"]:
    print(version["contentVersion"], version["digest"])
' "$layer"
}

# Pulls every version the deployment file lists and writes them to wanted. Fails,
# changing nothing, when the file or any pull fails.
read_wanted() {
  local listed content digest image lines=""
  listed=$(read_deployment) || return 1
  [[ -n $listed ]] || return 1
  # The list arrives on its own descriptor, so nothing the loop runs can read from it.
  while read -r content digest <&3; do
    check_content "$content" || return 1
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    podman pull --quiet "$REGISTRY@$digest" >/dev/null || return 1
    image=$(image_id "$REGISTRY@$digest")
    # The image must be what the list says it is.
    [[ $(label "$image" $LABELS.content-version) == "$content" ]] || {
      echo "$REGISTRY@$digest is not content $content" >&2
      return 1
    }
    podman tag "$image" "$PINNED:$content-listed"
    lines+="$content $image"$'\n'
  done 3<<<"$listed"
  printf '%s' "$lines" | head -n "$MAX_VERSIONS" >"$wanted_file.new"
  mv -f "$wanted_file.new" "$wanted_file"
}

# A check that cannot reach the registry changes nothing: the pinned images keep running.
# The journal hears when checks start failing and when they work again, not every check.
check_failed() {
  if [[ ! -f $failing_file ]]; then
    echo "Cannot read $follow from the registry; checking again quietly" >&2
    touch "$failing_file"
  fi
}
check_worked() {
  if [[ -f $failing_file ]]; then
    rm -f "$failing_file"
    echo "Reading $follow from the registry works again"
  fi
}

# Whether a version's server may change now: at once on dev or when told to (`now`),
# otherwise once nobody plays on it or it has waited its maximum since `since_file`.
may_change() {
  local content=$1 now_mode=$2 since_file=$3 now first players
  if [[ $now_mode == now || $environment == dev ]]; then return 0; fi
  now=$(date +%s)
  first=$(read_file "$since_file")
  first=${first##* }
  players=$(players "$content")
  if ((players == 0 || now - ${first:-$now} >= MAX_WAIT_SECONDS)); then return 0; fi
  echo "Waiting: $players playing on $(unit "$content"), $((now - ${first:-$now}))s of ${MAX_WAIT_SECONDS}s"
  return 1
}

# Brings the servers in line with wanted: starts listed versions, switches a listed
# version to its listed image and stops versions no longer listed, the last two once
# may_change allows. `now` (a pull) waits for nobody. Fails when a listed image does not
# run, now or after an earlier failed health check.
reconcile() {
  local mode=$1 content image dir changed=0 failed=0 pending
  # The list arrives on its own descriptor, so nothing the loop runs can read from it.
  while read -r content image <&3; do
    [[ -n $content ]] || continue
    dir=$(version_dir "$content")
    rm -f "$dir/retiring" "$dir/override"
    if [[ $image == "$(read_file "$dir/failed")" ]]; then
      failed=1
    elif [[ ! -f $dir/image ]]; then
      start_version "$content" "$image" || failed=1
      changed=1
    elif [[ $image != "$(read_file "$dir/image")" ]]; then
      pending=$(read_file "$dir/pending")
      if [[ ${pending%% *} != "$image" ]]; then
        write_file "$dir/pending" "$image $(date +%s)"
        echo "New image for $(unit "$content"): $(describe "$image")"
      fi
      if may_change "$content" "$mode" "$dir/pending"; then
        switch_version "$content" "$image" || failed=1
        changed=1
      fi
    else
      rm -f "$dir/pending"
    fi
  done 3<"$wanted_file"
  for content in $(running); do
    is_wanted "$content" && continue
    dir=$(version_dir "$content")
    [[ -f $dir/retiring ]] || {
      date +%s >"$dir/retiring"
      echo "$(unit "$content") is no longer listed; it stops once its rooms are empty"
    }
    if may_change "$content" "$mode" "$dir/retiring"; then
      stop_version "$content"
      changed=1
    fi
  done
  content=$(wanted | head -n 1)
  if [[ -n $content && -f $(version_dir "$content")/image ]]; then write_file "$root_file" "$content"; fi
  write_caddyfile || failed=1
  if ((changed)); then remove_old_images; fi
  return "$failed"
}

# The timer's check. It follows the deployment file unless a hold is set, reading the file
# again only after its digest moved. A hold on dev ends with the next publish: whoever published wants
# that build running now.
auto() {
  if [[ -f $hold_file && $environment != dev ]]; then
    echo "Holding: $(cat "$hold_file")"
    return 0
  fi
  local digest followed=""
  if ! digest=$(remote_digest); then
    check_failed
    return 0
  fi
  followed=$(read_file "$followed_file")
  if [[ $digest != "$followed" || ! -f $wanted_file ]]; then
    if ! read_wanted; then
      check_failed
      return 0
    fi
    write_file "$followed_file" "$digest"
    if [[ -f $hold_file ]]; then
      echo "A new $follow ends the hold: $(cat "$hold_file")"
      rm -f "$hold_file"
    fi
  fi
  check_worked
  if [[ -f $hold_file ]]; then return 0; fi
  # A failed image waits for the file to list another; the journal has said why.
  reconcile wait || true
}

status() {
  local content dir root
  root=$(read_file "$root_file")
  for content in $(running); do
    dir=$(version_dir "$content")
    echo "version:  $content on port $(port_of "$content")$([[ $content == "$root" ]] && echo ", at the root")$(is_wanted "$content" || echo ", no longer listed")"
    echo "  service:  $(unit "$content") ($(systemctl is-active "$(unit "$content")" || true))"
    echo "  running:  $(describe "$(read_file "$dir/image")")"
    if [[ -f $dir/previous ]]; then echo "  previous: $(describe "$(read_file "$dir/previous")")"; fi
    if [[ -f $dir/pending ]]; then
      local pending
      pending=$(read_file "$dir/pending")
      echo "  pending:  $(describe "${pending%% *}") since $(date -u -d "@${pending##* }" +%FT%TZ)"
    fi
    if [[ -f $dir/retiring ]]; then echo "  stopping: once empty, waiting since $(date -u -d "@$(cat "$dir/retiring")" +%FT%TZ)"; fi
    if [[ -f $dir/failed ]]; then echo "  failed:   $(describe "$(read_file "$dir/failed")")"; fi
  done
  for content in $(wanted); do
    if [[ ! -f $(version_dir "$content")/image ]]; then
      echo "version:  $content listed, not running$([[ -f $(version_dir "$content")/failed ]] && echo " (its image failed its health check)")"
    fi
  done
  if [[ -f $hold_file ]]; then echo "hold:     $(cat "$hold_file")"; fi
  echo "auto:     $(systemctl is-enabled sloppy-tanks-update.timer 2>/dev/null || true), following $follow"
  if [[ -f $failing_file ]]; then
    echo "registry: no answer for $follow since $(date -u -r "$failing_file" +%FT%TZ)"
  fi
}

case $command in
  pull)
    requested=${2:-$follow}
    if [[ $requested == "$follow" ]]; then
      digest=$(remote_digest) || true
      if [[ -z $digest && $follow != "$REGISTRY:deployment-production" ]]; then
        # A machine created before anything was published to its environment (dev,
        # app-store) runs production's newest server meanwhile, so it is up and listed;
        # auto-update still follows its file and switches to the first publish. That is no
        # hold.
        newest=$(read_deployment deployment-production | head -n 1) || true
        newest=${newest#* }
        [[ $newest =~ ^sha256:[0-9a-f]{64}$ ]] || {
          echo "Nothing to read on $follow, nor on production's deployment file" >&2
          exit 1
        }
        echo "Nothing to read on $follow; starting production's newest server until a publish"
        podman pull --quiet "$REGISTRY@$newest" >/dev/null
        run_now "$(image_id "$REGISTRY@$newest")"
        write_caddyfile
        exit 0
      fi
      read_wanted
      if [[ -n $digest ]]; then write_file "$followed_file" "$digest"; fi
      rm -f "$hold_file"
      reconcile now
    else
      podman pull --quiet "$requested" >/dev/null
      new=$(image_id "$requested")
      run_now "$new"
      write_caddyfile
      hold "Pulled $requested" "$new"
    fi
    ;;
  local)
    new=$(image_id "${2:?local needs an image}")
    run_now "$new"
    write_caddyfile
    hold "SSH deploy" "$new"
    ;;
  rollback)
    content=$(read_file "$root_file")
    previous=$(read_file "$(version_dir "${content:-none}")/previous")
    [[ -n $previous ]] || {
      echo "No previous image for the root version" >&2
      exit 1
    }
    switch_version "$content" "$previous"
    hold "Rollback" "$previous"
    ;;
  resume)
    rm -f "$hold_file"
    echo "Auto-update follows $follow again (if enabled)"
    ;;
  auto) auto ;;
  caddyfile) write_caddyfile ;;
  status) status ;;
  stats)
    for content in $(running); do
      echo "== $content (port $(port_of "$content"))"
      curl -fsS --max-time 5 "http://127.0.0.1:$(port_of "$content")/stats" || true
      echo
    done
    ;;
  *) usage ;;
esac
