# Installed to /etc/containers/systemd/ by provision.sh. Quadlet turns it into
# caddy.service: Caddy's official image terminating TLS in front of the game server.
# To upgrade Caddy, change Image= (tag and digest from Docker Hub) and provision again.
[Unit]
Description=Caddy, TLS in front of the Sloppy Tanks server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2.11.4@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52
# Pulled once by provisioning; a restart or reboot never needs the registry.
Pull=missing
# Host networking reaches the server on loopback and gives Caddy the players' real
# addresses and ports, whose sockets the server reads round trips from (X-Client-Port).
Network=host
# The directory, not the file: provisioning replaces the Caddyfile, and a bind mount of
# a single file would keep showing the replaced one.
Volume=/etc/sloppy-tanks/caddy:/etc/caddy:ro
# Certificates and ACME state stay on the host (provision.sh creates the directories),
# outliving restarts and upgrades, so Caddy never asks Let's Encrypt again for a name it
# already has a certificate for (5 per name a week).
Volume=/var/lib/caddy/data:/data
Volume=/var/lib/caddy/config:/config
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
LogDriver=passthrough

[Service]
ExecReload=/usr/bin/podman exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
