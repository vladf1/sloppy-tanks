# Installed to /etc/containers/systemd/ by provision.sh. Quadlet turns it into
# sloppy-tanks.service, which runs the server under Podman with no daemon beside it.
# Docker's sloppy-tanks.service is the fallback (crates/server/README.md, "Container
# runtime").
[Unit]
Description=Sloppy Tanks multiplayer server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=sloppy-tanks
# Image= is the image ID pinned in sloppy-tanks.container.d/image.conf, which only
# sloppy-tanks-update writes. Until a deploy pins one, Quadlet generates no service.
# The pinned image is always local, so a crash or reboot never needs the registry.
Pull=never
# Host networking keeps the listener on loopback (HOST in the env file) behind Caddy,
# with the real peer address, and leaves no ports to publish past the firewall.
Network=host
EnvironmentFile=/etc/sloppy-tanks.env
# As Docker's flags: a read-only root without Podman's extra tmpfs mounts, no
# capabilities, and a memory cap without swap.
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=ALL
NoNewPrivileges=true
Memory=700m
PodmanArgs=--memory-swap 700m
PidsLimit=256
Ulimit=nofile=65536:65536
# Output goes straight to the unit's journal, as before (pnpm run server:logs).
LogDriver=passthrough
# SIGTERM resets rooms and waits up to a second for clients to finish closing.
StopTimeout=10

[Service]
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
