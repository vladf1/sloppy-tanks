[Unit]
Description=Sloppy Tanks dev multiplayer server (the dev site's rooms)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# The image ID sloppy-tanks-update pinned. The service starts once a deploy has pinned one.
EnvironmentFile=/var/lib/sloppy-tanks/dev.image
# As sloppy-tanks.service; the dev copy shares the one-vCPU host with production, so it
# stays small.
ExecStartPre=-/usr/bin/docker rm --force sloppy-tanks-dev
ExecStart=/usr/bin/docker run --rm --name sloppy-tanks-dev --network host \
  --env-file /etc/sloppy-tanks-dev.env \
  --read-only --cap-drop ALL --security-opt no-new-privileges \
  --memory 250m --memory-swap 250m --pids-limit 256 --ulimit nofile=65536:65536 \
  ${IMAGE}
# SIGTERM resets rooms and waits up to a second for clients to finish closing.
ExecStop=/usr/bin/docker stop --time 10 sloppy-tanks-dev
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
