# sloppy-tanks-server.fridman.me is an A record at Namecheap, so moving providers means
# updating that record. Caddy obtains its certificate and forwards WebSocket upgrades as-is.
# X-Client-Port (with X-Forwarded-For) names the player's end of Caddy's socket to them,
# which the game server reads its TCP round trip and retransmissions from.
sloppy-tanks-server.fridman.me {
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Client-Port {remote_port}
	}
}

# The dev site's server (sloppy-tanks-dev.service) on another port of the same hostname,
# so it shares the certificate and needs no DNS record of its own.
sloppy-tanks-server.fridman.me:8443 {
	reverse_proxy 127.0.0.1:8788 {
		header_up X-Client-Port {remote_port}
	}
}
