{
  "$schema": "../tools/deploy/node_modules/wrangler/config-schema.json",
  "name": "sloppy-tanks-directory",
  "account_id": "b49a59dfb5edf913223ad13eeab8d740",
  // No newer than the pinned wrangler's local runtime supports, so `wrangler dev` runs it.
  "compatibility_date": "2026-09-23",
  "main": "worker.ts",
  // Game servers and the page reach the directory only through its custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "directory.sloppytanks.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServerDirectory"] },
    // ServerDirectory kept its servers in key-value storage; Directory starts with a fresh
    // database for its SQL table, and deleting the old class drops that storage.
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "deleted_classes": ["ServerDirectory"] },
  ],
  "observability": { "enabled": true },
  // The overview page; requests for anything else, such as /servers, reach the Worker.
  "assets": { "directory": "./public" },
}
