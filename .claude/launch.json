{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "tunnel",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PATH=/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH exec bun run tunnel"
      ],
      "port": 4179
    },
    {
      "name": "game-server",
      "runtimeExecutable": "./target/server/sloppy-server",
      "runtimeArgs": [],
      "port": 8787
    },
    {
      "name": "directory",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "wrangler",
        "dev",
        "--config",
        "directory/wrangler.jsonc",
        "--port",
        "8794"
      ],
      "port": 8794
    }
  ]
}
